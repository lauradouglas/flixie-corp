{
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  },
  "mimeTypes": {
    ".xml": "application/xml",
    ".txt": "text/plain",
    ".json": "application/json"
  },
  "globalHeaders": {
    "Referrer-Policy": "same-origin",
    "X-Content-Type-Options": "nosniff"
  },
  "routes": [
    {
      "route": "/.well-known/apple-app-site-association",
      "headers": {
        "Content-Type": "application/json"
      }
    }
  ]
}

{
  "trailingSlash": "never",
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  },
  "mimeTypes": {
    ".xml": "application/xml",
    ".txt": "text/plain",
    ".json": "application/json"
  },
  "globalHeaders": {
    "Referrer-Policy": "same-origin",
    "X-Content-Type-Options": "nosniff"
  },
  "routes": [
    {
      "route": "/android",
      "redirect": "https://play.google.com/store/apps/details?id=com.flixie.app",
      "statusCode": 302
    },
    {
      "route": "/iphone",
      "redirect": "https://apps.apple.com/gb/app/flixie/id6779375028",
      "statusCode": 302
    },
    {
      "route": "/.well-known/apple-app-site-association",
      "headers": {
        "Content-Type": "application/json"
      },
      "rewrite": "/.well-known/apple-app-site-association.json"
    },
    {
      "route": "/movies/*",
      "rewrite": "/media-share.html",
      "headers": {
        "X-Robots-Tag": "noindex"
      }
    },
    {
      "route": "/shows/*",
      "rewrite": "/media-share.html",
      "headers": {
        "X-Robots-Tag": "noindex"
      }
    }
  ]
}

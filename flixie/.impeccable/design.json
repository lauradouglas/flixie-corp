      "html": "<section class=\"ds-sheet\" aria-label=\"Your Watch Plan\"><div class=\"ds-sheet-top\"><h2>Your Watch Plan</h2><button class=\"ds-sheet-close\" aria-label=\"Close\" type=\"button\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"m18 6-12 12M6 6l12 12\"/></svg></button></div><p>Keep the plan going in Flixie.</p></section>",
      "css": ".ds-sheet{font-family:FlixieManrope,Arial,sans-serif;box-sizing:border-box;width:min(560px,100%);max-height:min(85dvh,850px);overflow:auto;overscroll-behavior:contain;padding:24px;border:0;border-radius:16px;background:var(--fx-surface,light-dark(#fff,#1e1f30));color:var(--fx-ink,light-dark(#261735,#f5f7fa));box-shadow:0 18px 55px #0005}.ds-sheet-top{display:flex;align-items:flex-start;justify-content:space-between;gap:15px;margin-bottom:13px}.ds-sheet h2{font-size:18px;font-weight:750;line-height:1.3;letter-spacing:-.02em;margin:0}.ds-sheet p{font-size:14px;line-height:1.6;color:var(--fx-muted,light-dark(#62566f,#b7c2d0));margin:10px 0 18px}.ds-sheet-close{display:inline-grid;place-items:center;min-width:40px;min-height:40px;padding:7px;border:0;border-radius:8px;background:transparent;color:inherit;cursor:pointer}.ds-sheet-close:not(:disabled):hover{filter:brightness(1.09)}.ds-sheet-close:focus-visible{outline:3px solid var(--fx-purple,light-dark(#6534b8,#b9a0ff));outline-offset:3px}.ds-sheet-close:active{transform:translateY(1px)}.ds-sheet-close:disabled{opacity:.5;cursor:wait}@media(pointer:coarse){.ds-sheet-close{min-width:44px;min-height:44px}}"

  "narrative": {
    "northStar": "Flixie's existing app identity",
    "overview": "This document records the connected browser implementation in `src/web/`, the public catalogue in `src/components/CatalogView.tsx`, and the shared mobile app prompt. It extends the approved Flixie concept with the existing account and backend. The white/purple wordmark, bundled Manrope, official Pip and F assets, full portrait film artwork and each person's own badge border remain the visual authority.\n\nCompact navigation and tonal lavender or navy surfaces keep personal films and actions easy to scan. Film artwork carries the visual interest; purple marks actions and selected states. Desktop can show personal film, television, friend and plan information in parallel; smaller containers reflow the same content. Public pages distinguish title information, rating sources and deliberately public reviews from personal account content.\n\nThis is a scoped browser system. The pre-existing marketing shell and its Inter/Space Grotesk styles remain separate, including the header/footer surrounding the catalogue. Browser dimensions here do not replace native Flutter tokens. Product scope and release dependencies live in `PRODUCT.md` and `docs/web-app.md`; surface composition stays in `.impeccable/web-app-brief.md`.",
    "keyCharacteristics": [
      "White flix / purple ie wordmark on dark chrome, with the approved Arial lettering exception.",
      "Bundled Manrope, strong title weights and readable body copy.",
      "Complete portrait artwork, personal badge borders and restrained official Pip/F accents.",
      "Tonal depth, thin separators and rounded controls.",
      "Connected account actions, explicit data states and scrollable bottom sheets."
    ],
    "rules": [
      {
        "name": "The Brand Continuity Rule",
        "body": "Extend the existing Flixie identity; this connected browser system does not authorize rebranding the marketing site or native app.",
        "section": "colors"
      },
      {
        "name": "The Readable Copy Rule",
        "body": "Preserve the paragraph base, text scaling and wrapping; compact metadata does not authorize shrinking general copy or hiding meaningful text with ellipses.",
        "section": "typography"
      },
      {
        "name": "The Tonal Depth Rule",
        "body": "Use the existing surface hierarchy and lines for content structure; reserve the recorded shadows for overlays and transient feedback.",
        "section": "elevation & depth"
      },
      {
        "name": "The Complete Artwork Rule",
        "body": "Show the full portrait poster and preserve its proportions in shelves, public detail, diary rows and picker results.",
        "section": "shapes"
      }
    ],
    "dos": [
      "**Do** extend the approved Flixie identity and keep this system scoped to the connected browser surfaces.",
      "**Do** show complete portrait artwork with contain fitting and truthful missing-artwork fallbacks.",
      "**Do** preserve each person's awarded and selected badge preference, including an explicit choice of no border.",
      "**Do** keep general body copy readable and reflow meaningful titles, metadata and actions.",
      "**Do** use bounded, scrollable bottom sheets for choices and account actions, preserving keyboard focus.",
      "**Do** label rating sources, public reviews and spoilers, and render real loading, empty and retry states.",
      "**Do** keep both desktop store destinations discoverable and mobile download prompts compact and dismissible."
    ],
    "donts": [
      "**Don't** promote browser sidebar widths, catalogue header clearance or unused prototype frame rules into the native app system.",
      "**Don't** replace the pre-existing marketing design system as a side effect of extending the connected app.",
      "**Don't** crop film posters into landscape imagery or stretch their proportions.",
      "**Don't** replace individual border preferences with one universal ring or grant an unawarded frame.",
      "**Don't** expose personal diary notes, friend activity, plans or private reviews on public title or search-discovery pages.",
      "**Don't** invent films, availability, reviews, scores or achieved search rankings to fill absent state.",
      "**Don't** turn app download guidance into a redirect or screen-covering install interstitial."
    ]
  }
}
